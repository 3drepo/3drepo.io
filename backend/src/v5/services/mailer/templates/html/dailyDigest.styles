:root {
	/* Product design system tokens */
	--bg:      #ffffff;
	--fg:      rgb(23, 43, 77);
	--accent:  #1677ff;
	--surface: #f7f8fa;
	--muted:   #6b7280;
	--border:  #d9dee7;
	/* Semantic status — justified extension for usability */
	--c-success-bg:  #dcfce7;
	--c-success-fg:  #15803d;
	--c-success-dot: #16a34a;
	--c-failed-bg:   #fee2e2;
	--c-failed-fg:   #dc2626;
	--c-failed-dot:  #dc2626;
	--c-aborted-bg:  #fef9c3;
	--c-aborted-fg:  #b45309;
	--c-aborted-dot: #d97706;
	/* Result pill semantic */
	--c-new-bg:          #eff6ff;
	--c-new-border:      #bfdbfe;
	--c-new-fg:          #1d4ed8;
	--c-active-bg:       #fef9c3;
	--c-active-border:   #fde68a;
	--c-active-fg:       #b45309;
	--c-resolved-bg:     #dcfce7;
	--c-resolved-border: #bbf7d0;
	--c-resolved-fg:     #15803d;

	--font: Inter, system-ui, -apple-system, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
}

/* ── Notification container ─────────────────────── */
div.notifications {
	width: 100%;
	padding: 10px 0;
	align-items: center;
	display: inline-flex;
}

div.notificationsTable {
	width: 100%;
	border-radius: 10px;
	border: 1px #E5EDF4 solid;
	flex-direction: column;
	display: inline-flex;
	margin-top: 8px;
}

div.notificationsHeader {
	align-self: stretch;
	padding: 0px 14px;
	background: #E5EDF4;
	border-top-left-radius: 10px;
	border-top-right-radius: 10px;
	justify-content: space-between;
	align-items: center;
	display: inline-flex;
}

div.headerTitle {
	display: flex;
	align-items: center;
}

div.notificationsContent {
	padding: 5px 20px 5px 20px;
	flex-direction: column;
	align-items: flex-start;
	display: flex;
}

p.title {
	font-size: 0.9rem;
	color: #172B4D;
	font-weight: 500;
	margin: 20px 0;
	word-wrap: break-word;
}

/* ── Model block & labels ────────────────────────── */
.modelBlock {
	display: grid;
	grid-template-columns: 160px 1fr;
	border: 1px solid var(--border);
	border-radius: 8px;
	overflow: hidden;
	margin-bottom: 8px;
	margin-top: 8px;
	background: #fff;
	width: 100%;
}

.modelLabelCell {
	padding: 14px 16px;
	border-right: 1px solid var(--border);
	background: var(--surface);
}

.sectionLabel {
	font-size: 10px;
	font-weight: 700;
	letter-spacing: 0.1em;
	text-transform: uppercase;
	color: var(--muted);
	margin-bottom: 2px;
}

.dataValue {
	font-size: 13px;
	font-weight: 500;
	color: var(--muted);
}

/* ── Clash plan grouping & rows ──────────────────── */
.planGroup {
	display: flex;
	flex-direction: column;
	gap: 0;
	border: 0;
}

.runRow {
	padding: 12px 14px;
	border: 1px solid var(--border);
	border-radius: 8px;
	background: var(--bg);
	display: grid;
	grid-template-columns: minmax(148px, 1.4fr) minmax(100px, 0.75fr) minmax(82px, 0.5fr) 1fr;
	gap: 12px;
	align-items: start;
}

.onlyChild {
	border-radius: 8px;
}

.firstChild {
	border-radius: 8px 8px 0 0;
	border-bottom: none;
}

.middleChild {
	border-radius: 0;
	border-bottom: none;
}

.lastChild {
	border-radius: 0 0 8px 8px;
}

.evenRows {
	background: #f9fbff;
}

.cellLabel {
	display: block;
	margin-bottom: 4px;
	font-size: 10px;
	font-weight: 700;
	letter-spacing: 0.1em;
	text-transform: uppercase;
	color: var(--muted);
	line-height: 1;
}

/* ── Ticket list ─────────────────────────────────── */
.modelTicketList {
	display: flex;
	flex-direction: column;
}

.ticketRow {
	display: grid;
	grid-template-columns: 22px 1fr auto;
	align-items: center;
	gap: 10px;
	padding: 11px 20px;
	border-top: 1px solid var(--border);
	font-size: 13px;
	color: var(--muted);
}

.modelTicketList .ticketRow:first-child {
	border-top: none;
}

.openLink {
	font-size: 10px;
	font-weight: 700;
	letter-spacing: 0.06em;
	text-transform: uppercase;
	color: var(--muted);
	text-decoration: none;
	white-space: nowrap;
}

.ticketIcon {
	width: 20px;
	height: 20px;
	border-radius: 50%;
	border: 1.5px solid var(--muted);
	display: grid;
	place-items: center;
	font-size: 12px;
	font-weight: 400;
	color: var(--muted);
	flex: 0 0 auto;
}

.ticketIcon.tAssign {
	border-color: var(--c-new-fg);
	color: var(--c-new-fg);
}

.ticketIcon.tResolved {
	border-color: var(--c-resolved-fg);
	color: var(--c-resolved-fg);
}

/* ── Status badge ────────────────────────────────── */
.statusBadge {
	display: inline-flex;
	align-items: center;
	gap: 5px;
	padding: 3px 8px 3px 6px;
	border-radius: 999px;
	font-size: 12px;
	font-weight: 700;
	letter-spacing: 0.02em;
	line-height: 1.5;
}

.statusDot {
	width: 6px;
	height: 6px;
	border-radius: 999px;
	flex: 0 0 auto;
}

.sSuccess {
	background: var(--c-success-bg);
	color: var(--c-success-fg);
}
.sSuccess .statusDot { background: var(--c-success-dot); }

.sFailed {
	background: var(--c-failed-bg);
	color: var(--c-failed-fg);
}
.sFailed .statusDot { background: var(--c-failed-dot); }

.sAborted {
	background: var(--c-aborted-bg);
	color: var(--c-aborted-fg);
}
.sAborted .statusDot { background: var(--c-aborted-dot); }

/* ── Result pills ────────────────────────────────── */
.resultPills {
	display: flex;
	flex-wrap: wrap;
	gap: 5px;
}

.pill {
	display: inline-flex;
	align-items: baseline;
	gap: 4px;
	padding: 4px 8px;
	border-radius: 6px;
	border: 1px solid;
	font-size: 12px;
	line-height: 1.2;
}

.pill strong {
	font-size: 13px;
	font-weight: 700;
	line-height: 1;
}

.pillNew {
	background: var(--c-new-bg);
	border-color: var(--c-new-border);
	color: var(--c-new-fg);
}

.pillActive {
	background: var(--c-active-bg);
	border-color: var(--c-active-border);
	color: var(--c-active-fg);
}

.pillResolved {
	background: var(--c-resolved-bg);
	border-color: var(--c-resolved-border);
	color: var(--c-resolved-fg);
}
